generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better-Auth Core Tables ───

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      Session[]
  accounts      Account[]
  settings      UserSettings?
  preferences   UserPreferences?
  deezerCred    DeezerCredential?
  playlists     Playlist[]
  savedTracks   SavedTrack[]
  savedAlbums   Album[]
  sharedTracks  SharedTrack[]
  recentPlays   RecentPlay[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

// ─── Legacy Config Table (used by Spotify plugin & global settings) ───

model Config {
  userId    String   @default("default") @map("user_id")
  key       String
  value     Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz

  @@id([userId, key])
  @@map("config")
}

// ─── Application Tables ───

model DeezerCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  arl               String
  deezerUserId      BigInt?
  deezerUserName    String?
  deezerPicture     String?
  canStreamHq       Boolean  @default(false)
  canStreamLossless Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("deezer_credential")
}

model UserSettings {
  id       String @id @default(cuid())
  userId   String @unique
  settings Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserPreferences {
  id          String   @id @default(cuid())
  userId      String   @unique
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// ─── User Library ───
//
// Spotify-like model:
//   • SavedTrack = explicitly liked tracks (≈ "Liked Songs")
//   • Album      = saved albums + their tracklist (Spotify "Your Library > Albums")
//   • Playlist   = user-created playlists (or saved public ones)
//
// File persistence is orthogonal — see StoredTrack. A saved track may or may
// not have a backing audio file; playback is always served via the progressive
// streaming engine which fetches/persists/evicts files transparently.

model Playlist {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  coverUrl    String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks PlaylistTrack[]

  @@map("playlist")
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  title      String
  artist     String
  album      String?
  albumId    String?
  coverUrl   String?
  duration   Int?
  position   Int
  addedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@map("playlist_track")
}

model SavedTrack {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  title     String
  artist    String
  album     String?
  albumId   String?
  coverUrl  String?
  duration  Int?
  savedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, savedAt(sort: Desc)])
  @@index([trackId])
  @@map("saved_track")
}

model Album {
  id            String   @id @default(cuid())
  userId        String
  deezerAlbumId String
  title         String
  artist        String
  coverUrl      String?
  trackCount    Int      @default(0)
  savedAt       DateTime @default(now())

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks AlbumTrack[]

  @@unique([userId, deezerAlbumId])
  @@index([userId, savedAt(sort: Desc)])
  @@map("album")
}

model AlbumTrack {
  id          String  @id @default(cuid())
  albumId     String
  trackId     String
  title       String
  artist      String
  coverUrl    String?
  duration    Int?
  trackNumber Int?

  album Album @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@unique([albumId, trackId])
  @@index([trackId])
  @@map("album_track")
}

// ─── File Cache (server-side, transparent to user) ───
//
// Global cache of audio files persisted to S3/local. Keyed by trackId+bitrate
// so the same file can serve multiple users (dedup). Lifecycle is automatic:
//   • populated on first play via /api/v1/stream-progressive
//   • evicted when a play is skipped <30s OR when the user's recent-plays
//     cap (100) pushes it out
//   • re-fetched on demand when an evicted track is replayed
//
// Ref-counted via SavedTrack[trackId], AlbumTrack[trackId], SharedTrack[trackId],
// RecentPlay[trackId]. When all refs drop, the file becomes orphan and is
// safe to delete (handled by the eviction helper).

model StoredTrack {
  id          String   @id @default(cuid())
  trackId     String
  bitrate     Int
  storagePath String
  storageType String
  fileSize    Int?
  createdAt   DateTime @default(now())

  sharedTracks SharedTrack[]

  @@unique([trackId, bitrate])
  @@index([trackId])
  @@map("stored_track")
}

// ─── Recent Plays (Spotify-like history; counted at 30s of playback) ───

model RecentPlay {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  title     String
  artist    String
  album     String?
  albumId   String?
  coverUrl  String?
  duration  Int?
  playedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([userId, playedAt(sort: Desc)])
  @@map("recent_play")
}

// ─── Stem Separation (AI vocal/instrument splitting) ───
//
// Per-track AI separation jobs. The worker (stems-worker container) runs
// Demucs (htdemucs_6s) on a cached audio file and produces N stem files
// (vocals, drums, bass, guitar, piano, other) or two stems (vocals,
// no_vocals) depending on `mode`. Files are uploaded to S3 alongside the
// original under `stems/{trackId}/{stemName}.mp3`.
//
// Job dedup: BullMQ uses the trackId as jobId, so concurrent requests for
// the same track collapse into a single worker run; the StemSeparation row
// is upserted by trackId. Re-running after completion is allowed once the
// 24h dedup window expires (see queue config).

model StemSeparation {
  id           String    @id @default(cuid())
  trackId      String    @unique
  status       String    // "pending" | "processing" | "completed" | "failed"
  mode         String    // "two_stems" | "six_stems"
  progress     Int       @default(0)
  errorMessage String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  files StemFile[]

  @@index([status])
  @@map("stem_separation")
}

model StemFile {
  id           String   @id @default(cuid())
  separationId String
  trackId      String
  stemName     String   // "vocals" | "no_vocals" | "drums" | "bass" | "guitar" | "piano" | "other"
  storagePath  String
  storageType  String   // "s3" | "local"
  fileSize     Int?
  createdAt    DateTime @default(now())

  separation StemSeparation @relation(fields: [separationId], references: [id], onDelete: Cascade)

  @@unique([trackId, stemName])
  @@index([trackId])
  @@map("stem_file")
}

// ─── External → Deezer track match cache ───
//
// Cross-platform suggestion engine: Spotify (or other sources) feed the
// autocomplete and search-enrichment flows; we cache the resolved Deezer
// trackId here so repeated suggestions don't re-pay the matching cost.
//
// `deezerTrackId` is null when the matcher couldn't find anything on Deezer
// (kept as a negative cache for `NEG_TTL_MS`, see search/resolve route).

model TrackMatch {
  id            String   @id @default(cuid())
  source        String   // "spotify"
  sourceId      String   // e.g. Spotify track ID
  isrc          String?
  deezerTrackId String?
  strategy      String?  // "isrc" | "advanced" | "advanced-clean" | "fuzzy" | "not_found"
  confidence    Float?
  resolvedAt    DateTime @default(now())

  @@unique([source, sourceId])
  @@index([isrc])
  @@map("track_match")
}

// ─── Track Sharing ───
//
// Public share links for individual tracks. The file may be evicted from S3
// after the share is created — playback falls back to re-streaming via the
// progressive engine using the share creator's stored Deezer credentials.

model SharedTrack {
  id            String    @id @default(cuid())
  shareId       String    @unique
  trackId       String
  userId        String
  title         String
  artist        String
  album         String?
  coverUrl      String?
  duration      Int?
  storedTrackId String?
  expiresAt     DateTime?
  plays         Int       @default(0)
  createdAt     DateTime  @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storedTrack StoredTrack? @relation(fields: [storedTrackId], references: [id])

  @@index([userId])
  @@index([trackId])
  @@map("shared_track")
}
