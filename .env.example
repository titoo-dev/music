# ── Redis (required for stems queue) ──
REDIS_URL=redis://redis:6379

# ── PostgreSQL (required) ──
DATABASE_URL=postgresql://wavelet:wavelet@postgres:5432/wavelet
POSTGRES_USER=wavelet
POSTGRES_PASSWORD=wavelet
POSTGRES_DB=wavelet

# ── S3 / MinIO storage ──
# WAVELET_STORAGE_TYPE=s3
# WAVELET_S3_ENDPOINT=http://minio:9000
# WAVELET_S3_REGION=us-east-1
# WAVELET_S3_BUCKET=wavelet-music
# WAVELET_S3_ACCESS_KEY=minioadmin
# WAVELET_S3_SECRET_KEY=minioadmin
# WAVELET_S3_PATH_PREFIX=
# WAVELET_DOWNLOAD_LOCATION=/data/music

# ── MinIO ──
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ── Better Auth ──
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-secret-key-for-production
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Guest browsing (optional: shared Deezer ARL for unauthenticated users) ──
# WAVELET_SERVICE_ARL=

# ── Spotify (optional: enables "Import from Spotify" on playlist page) ──
# Create an app at https://developer.spotify.com/dashboard
# Client Credentials only — works for public playlists, no redirect URI needed
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
