# ── Redis (required for stems queue) ──
REDIS_URL=redis://redis:6379

# ── Convex (base de données — Postgres supprimé en Phase 6) ──
# Posés automatiquement par `npx convex dev` dans .env.local :
CONVEX_DEPLOYMENT=dev:your-deployment
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
# Auth Better Auth dans Convex :
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Migration de données (one-time, scripts/) : URL du Postgres SOURCE à
#     exporter vers Convex (npm run db:export / db:verify). Plus utilisé par
#     l'app — uniquement la bascule de données. À retirer une fois migré. ──
# DATABASE_URL=postgresql://deemix:deemix@postgres:5432/deemix

# ── S3 / MinIO storage ──
# DEEMIX_STORAGE_TYPE=s3
# DEEMIX_S3_ENDPOINT=http://minio:9000
# DEEMIX_S3_REGION=us-east-1
# DEEMIX_S3_BUCKET=deemix-music
# DEEMIX_S3_ACCESS_KEY=minioadmin
# DEEMIX_S3_SECRET_KEY=minioadmin
# DEEMIX_S3_PATH_PREFIX=
# DEEMIX_DOWNLOAD_LOCATION=/data/music

# ── MinIO ──
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin

# ── Better Auth ──
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-secret-key-for-production
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Guest browsing (optional: shared Deezer ARL for unauthenticated users) ──
# DEEMIX_SERVICE_ARL=

# ── Spotify (optional: enables "Import from Spotify" on playlist page) ──
# Create an app at https://developer.spotify.com/dashboard
# Client Credentials only — works for public playlists, no redirect URI needed
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
